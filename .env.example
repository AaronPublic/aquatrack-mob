# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Base URL (Point to your computer's local Wi-Fi IP or deployed URL)
EXPO_PUBLIC_API_URL=

# Mapbox Configuration
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token
EXPO_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12

# Firebase & Push Notification Project Configuration
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
